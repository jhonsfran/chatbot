# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Get your OpenRouter API key here for chat and image models: https://openrouter.ai/keys
OPENROUTER_API_KEY=****

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Server-side Unprice keys. Runtime keys can provision customers and enforce
# usage; config keys can only inspect and apply draft monetization configuration.
UNPRICE_TOKEN=unprice_****
UNPRICE_CONFIG_TOKEN=unprice_****
UNPRICE_API_URL=https://localhost:8787

# Optional. Leave UNPRICE_SIGNUP_PLAN_SLUG unset to provision new customers on
# the published Free plan and receive its wallet credit needed for chat budgets.
# Set this to `pro` to provision a fresh Pro demo customer with its $10 monthly cap.
# UNPRICE_SIGNUP_PLAN_SLUG=pro
# UNPRICE_API_URL=https://api.unprice.dev

# Used for the success/cancel URLs sent during customer provisioning.
NEXT_PUBLIC_APP_URL=http://localhost:3000
